{
    "version": 2,
    "builds": [
        {
            "src": "Backend/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "Backend/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "frontend/dist/$1"
        }
    ]
}