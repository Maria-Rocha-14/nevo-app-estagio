@startuml ADMIN-UseCase.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "System Administrator" as A

rectangle "ADMIN Module" {
  usecase "Manage Educational Quizzes" as UC1
  usecase "List and Suspend Users" as UC2
  usecase "View Global Statistics" as UC3
  usecase "Manage Badges and Achievements" as UC4
  usecase "Configure Scan Frequencies" as UC5
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
@enduml