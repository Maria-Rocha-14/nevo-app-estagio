@startuml ADMIN-UseCase.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "System Administrator" as A

rectangle "ADMIN Module" {
  usecase "View Admin Dashboard" as UC1
  usecase "Use Quick Actions" as UC2
  usecase "Manage Server-Side\nEducational Quizzes" as UC3
  usecase "List External Users" as UC4
  usecase "Suspend or Reactivate User" as UC5
  usecase "Manage Badges and\nAchievement Rewards" as UC6
  usecase "Configure Scan\nFrequency Rules" as UC7
}

A --> UC1
A --> UC2
A --> UC3
A --> UC4
A --> UC5
A --> UC6
A --> UC7

UC1 .> UC2 : <<include>>
UC4 .> UC5 : <<extend>>
@enduml
