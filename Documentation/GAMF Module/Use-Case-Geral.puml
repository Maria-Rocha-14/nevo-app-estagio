@startuml Use-Case-Geral.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "User" as U

rectangle "GAMF Module" {
  usecase "View Adaptive\nPrevention Goal" as UC1
  usecase "Complete Daily Sun\nProtection Mission" as UC2
  usecase "Start Daily Learning\nChallenge" as UC3
  usecase "Answer Mixed Question Types\n(Image, True/False, Multiple Choice)" as UC4
  usecase "View Challenge Summary\nand Review Questions" as UC5
  usecase "Earn Points and XP\nfor Correct Answers" as UC6
  usecase "Unlock Badges" as UC7
  usecase "Spend Points on\nAvatar Items" as UC8
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8

UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC4 .> UC6 : <<include>>
UC6 .> UC7 : <<extend>>

@enduml
