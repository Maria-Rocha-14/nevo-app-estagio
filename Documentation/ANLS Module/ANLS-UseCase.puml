@startuml ANLS-UseCase.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "User" as U

rectangle "ANLS Module" {
  usecase "Request Camera Capture\n(fallback if unavailable)" as UC1
  usecase "Upload Image from Gallery" as UC2
  usecase "Select Body Area" as UC3
  usecase "Confirm Automatic Scan" as UC4
  usecase "View Simulated Risk\nAssessment Results" as UC5
  usecase "Contact Medical Support" as UC6
  usecase "Return to Scan or History" as UC7
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7

UC2 .> UC3 : <<include>>
UC3 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
@enduml
