@startuml HIST-UseCase.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "User" as U

rectangle "HIST Module" {
  usecase "View Scan History Gallery" as UC1
  usecase "Side-by-Side Comparison" as UC2
  usecase "Export History" as UC3
}

U --> UC1
U --> UC2
U --> UC3
@enduml