@startuml Use-Case-Geral.puml
!theme plain
left to right direction
skinparam packageStyle rectangle

actor "User" as U
actor "System Administrator" as A

rectangle "Platform Overview" {
  usecase "User Management (USERM)" as UC1
  usecase "Analysis and Detection (ANLS)" as UC2
  usecase "Gamification and Engagement (GAMF)" as UC3
  usecase "History and Tracking (HIST)" as UC4
  usecase "Administration (ADMIN)" as UC5
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4

A --> UC5
@enduml